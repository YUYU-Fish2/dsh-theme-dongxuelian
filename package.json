{
  "name": "dsh-theme-dongxuelian",
  "version": "0.1.0-preview.4",
  "description": "A paper-white and indigo Dongxuelian pencil reading scene theme for DeepSeek Harness.",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "assets/characters/web/avatar.webp",
    "assets/scenes/web/reading.webp",
    "assets/characters/README.md",
    "assets/scenes/README.md",
    "cordis.patch.yml",
    "README.md",
    "docs/INSTALL.md",
    "docs/RELEASE.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
